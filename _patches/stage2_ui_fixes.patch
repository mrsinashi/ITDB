@@ -160,6 +160,46 @@ body {
     cursor: pointer;
 }
 
+/* Индикатор загрузки: тонкая полоска по нижнему краю панели, без сдвига кнопок.
+   Появляется с задержкой, чтобы быстрые обновления не мигали. */
+.toolbar .load-bar {
+    position: absolute;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    height: 2px;
+    overflow: hidden;
+    pointer-events: none;
+    opacity: 0;
+    transition: opacity 0.2s;
+}
+.toolbar .load-bar.on {
+    opacity: 1;
+    transition-delay: 0.25s;
+}
+.toolbar .load-bar::before {
+    content: "";
+    position: absolute;
+    top: 0;
+    bottom: 0;
+    left: -30%;
+    width: 30%;
+    background: #f1d7d7;
+}
+.toolbar .load-bar.on::before {
+    animation: load-slide 1.1s ease-in-out infinite;
+}
+@keyframes load-slide {
+    from { left: -30%; }
+    to { left: 100%; }
+}
+.toolbar .toolbar-error {
+    max-width: 360px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    color: #ffd0d0;
+}
+
 .toolbar button.active {
     background: #5b1f1f;
     border-color: #4c1d1d;
